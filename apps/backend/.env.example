# Copy to .env (never commit .env). Validated at startup by src/config/env.ts.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance?schema=public"

# Secret for signing access tokens (at least 32 characters). Generate one with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# Which proxies to trust for the client IP (rate limiting). "loopback" = the local Next.js proxy.
# TRUST_PROXY=loopback

# Database used by the integration tests. Its name must end with "_test" (it is wiped by the tests).
TEST_DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_test?schema=public"
